DATABASE_URL=postgres://tripatlas:tripatlas@localhost:5432/tripatlas
TESLAMATE_DATABASE_URL=postgres://teslamate:teslamate@localhost:5433/teslamate
APP_TIMEZONE=Europe/Zurich
SYNC_INTERVAL_SECONDS=60
# INITIAL_ADMIN_PASSWORD=

# --- Produktion (docker-compose.yml) -----------------------------------
# Passwort für die tripatlas-Postgres im Compose-Stack. Pflichtfeld, kein
# Default — Compose bricht ohne gesetzten Wert ab.
POSTGRES_PASSWORD=

# Port, unter dem die Web-App auf dem Host erreichbar ist (z. B. hinter
# Tailscale serve). Intern läuft der Container immer auf 3000.
WEB_PORT=3000

# In Produktion: read-only-Rolle auf der bestehenden TeslaMate-DB verwenden,
# siehe README "Deployment" für das CREATE ROLE-Statement. Host entweder
# LAN/Tailscale-Adresse oder, falls TeslaMate im selben Compose-Netz läuft,
# der Service-Name (siehe Kommentare in docker-compose.yml).
# TESLAMATE_DATABASE_URL=postgres://tripatlas_ro:...@teslamate-host:5432/teslamate

# Routenplaner: eigener OSRM-Server statt des öffentlichen Demo-Servers
# (https://project-osrm.org — der Demo-Server ist nicht für Dauerlast gedacht).
# OSRM_URL=https://router.project-osrm.org

# Tesla Fleet API (optional): route checkpoints directly to the vehicle.
# Requires a registered Tesla developer app and a public HTTPS callback/domain.
# Some vehicles also require a compatible command proxy and virtual key.
# Generate the encryption key with: openssl rand -base64 32
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# TESLA_REDIRECT_URI=https://example.com/api/tesla/callback
# TESLA_PARTNER_DOMAIN=example.com
# TESLA_TOKEN_ENCRYPTION_KEY=
# Public virtual key, base64-encoded PEM (can be served by Tripatlas):
# TESLA_PUBLIC_KEY_PEM_BASE64=
# TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.eu.vn.cloud.tesla.com
# Optional override when the endpoint needs a compatible signed-command proxy:
# TESLA_COMMAND_API_URL=https://tesla-command-proxy.example.com
